{
    "name": "imapkit",
    "version": "3.3.1",
    "description": "Scriptable, strictly RFC compliant in-memory IMAP server for testing IMAP clients",
    "main": "lib/server.js",
    "bin": {
        "imapkit": "bin/imapkit.js"
    },
    "files": [
        "bin",
        "cert",
        "lib"
    ],
    "scripts": {
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "test": "npm run lint && npm run test:unit",
        "test:unit": "node --test test/*.js",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-lines=94 test/*.js",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "compare": "node compare/compare.js",
        "dovecot:start": "bash compare/dovecot.sh start",
        "dovecot:stop": "bash compare/dovecot.sh stop",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/imapkit.git"
    },
    "bugs": {
        "url": "https://github.com/postalsys/imapkit/issues"
    },
    "homepage": "https://imapkit.com",
    "keywords": [
        "imap",
        "imap-server",
        "mock",
        "testing",
        "test-server",
        "imap4rev2",
        "rfc3501",
        "rfc9051",
        "email"
    ],
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "dependencies": {
        "imap-handler": "1.3.1",
        "smtp-server": "3.19.17"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.12.0",
        "globals": "17.13.0",
        "imapflow": "2.2.7",
        "prettier": "3.9.9"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
